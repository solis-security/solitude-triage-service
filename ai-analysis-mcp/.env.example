AI_OLLAMA_HOST=http://localhost:11434
AI_OLLAMA_MODEL=llama3.1
AI_OLLAMA_TIMEOUT_SECONDS=60
AI_CIRCUIT_BREAKER_WINDOW=20
AI_CIRCUIT_BREAKER_REJECTION_THRESHOLD=0.3
# Absolute path. Defaults to ~/.solitude/ai-audit.jsonl — never relative,
# because the MCP client chooses the working directory.
# AI_AUDIT_LOG_PATH=/absolute/path/to/ai-audit.jsonl
